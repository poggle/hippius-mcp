{
  "name": "hippius-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for uploading public or shareable files to Hippius S3.",
  "type": "module",
  "license": "MIT",
  "author": "poggle",
  "homepage": "https://github.com/poggle/hippius-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poggle/hippius-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/poggle/hippius-mcp/issues"
  },
  "keywords": [
    "hippius",
    "mcp",
    "model-context-protocol",
    "s3",
    "storage",
    "claude",
    "codex"
  ],
  "bin": {
    "hippius-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
